[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="ball"
3d_physics/layer_3="flippers"
3d_physics/layer_4="gadgets"
3d_physics/layer_5="drain"
3d_physics/layer_6="plunger"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=180
common/max_physics_steps_per_frame=16
3d/default_gravity=9.8
jolt_physics_3d/collisions/collision_margin_fraction=0.004
jolt_physics_3d/simulation/velocity_steps=12
jolt_physics_3d/simulation/position_steps=3
; Default (0.02 m) is huge next to a 27 mm ball and caused ghost bounces off nearby wall corners.
jolt_physics_3d/simulation/speculative_contact_distance=0.004

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
textures/canvas_textures/default_texture_filter=1
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.145098, 0.14902, 0.168627, 1)
