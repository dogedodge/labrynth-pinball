; Engine configuration file.
; Godot 4.x project (verified with 4.7.2). config_version=5 is the Godot 4 format.
config_version=5

[application]

config/name="Labrynth Pinball"
config/description="Minimal landscape pinball MVP built around the Labrynth table models."
config/version="0.1.0"
config/tags=PackedStringArray("game", "3d", "pinball")
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=0

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=false

